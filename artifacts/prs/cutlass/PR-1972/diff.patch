+    auto&& src_reg = cute::recast<uint32_t>(src)(0);
+    auto&& r       = cute::recast<RegArray>(dst)(0);
+    CUTLASS_PRAGMA_UNROLL
+    for (int ii = 0; ii < RegArray::kElements; ++ii) {
+      uint32_t tmp0, tmp1;
+      r[ii] = src_reg >> (8 * (ii));
+      static constexpr uint32_t or_mask    = 0x43004300;
