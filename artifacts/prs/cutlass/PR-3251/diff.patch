+        minus_row_max_scale,
+        local_row_sum,
+        inplace_consumer,
+        EXP2_EMULATION_OFFSET,
+        EXP2_EMULATION_COUNT,
+        CVT_COUNT,
+        CVT_PER_STEP,
+        FMA_COUNT,
+        ARV_COUNT,
+    ):
