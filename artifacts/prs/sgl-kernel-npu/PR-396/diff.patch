+    int64_t perCoreLastLoopElements = 0;
+    int64_t lastCoreElements = 0;
+    int64_t lastCoreLoops = 0;
+    int64_t lastCorePerLoopElements = 0;
+    int64_t lastCoreLastLoopElements = 0;
+    int64_t oneLoopMaxElements = 0;
+};
