+ * @param [in] executor: op executor containing the operator compute flow.
+ * @param [in] stream: acl stream.
+ * @return aclnnStatus: status code.
+ */
+__attribute__((visibility("default"))) aclnnStatus aclnnDispatchFFNCombine(void *workspace, uint64_t workspaceSize,
+                                                                           aclOpExecutor *executor, aclrtStream stream);
+
+#ifdef __cplusplus
+}
