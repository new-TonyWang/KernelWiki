+__aicore__ inline constexpr int32_t DecodeWidthTplKey(uint32_t widthKey)
+{
+    switch (widthKey) {
+        case CAUSAL_CONV1D_TPL_WIDTH_2:
+            return 2;
+        case CAUSAL_CONV1D_TPL_WIDTH_3:
+            return 3;
+        case CAUSAL_CONV1D_TPL_WIDTH_4:
+            return 4;
+        default:
+            return 0;
+    }
+}
