-HEADER=`dirname "$0"`/makeself-header.sh
-SIGNATURE=""
-TARGETDIR=""
-NOOVERWRITE=n
-DATE=`LC_ALL=C date`
-EXPORT_CONF=n
-SHA256=n
-OWNERSHIP=n
-SIGN=n
-GPG_PASSPHRASE=""
-
-# LSM file stuff
-LSM_CMD="echo No LSM. >> \"\$archname\""
