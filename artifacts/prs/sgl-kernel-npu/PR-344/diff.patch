-    fun = []
-    fun.append(fname)
-    fun.append("(")
-    args = []
-    for i in range(0, argn):
-        args.append(arg_name + str(i))
-    fun.append(", ".join(args))
-    fun.append(");")
-    body.append(" ".join(fun))
-    body.append("}")
-    return "\n".join(body)
