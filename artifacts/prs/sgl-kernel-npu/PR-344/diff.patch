-def check_file_size(input_file):
-    try:
-        file_size = os.path.getsize(input_file)
-    except OSError as os_error:
-        print('[ERROR] Failed to open "%s". %s' % (input_file, str(os_error)))
-        raise OSError from os_error
-    if file_size > 10 * 1024 * 1024:
