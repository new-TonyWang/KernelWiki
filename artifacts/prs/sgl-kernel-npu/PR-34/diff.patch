+  } while (0)
+
+#define OP_TILING_CHECK(cond, log_func, expr) \
+  do {                                        \
+    if (cond) {                               \
+      log_func;                               \
+      expr;                                   \
+    }                                         \
+  } while (0)
+}  // namespace optiling
