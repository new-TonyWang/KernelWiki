+
+#include <string>
+#include "toolchain/slog.h"
+
+#define OP_LOGI(opname, ...)
+#define OP_LOGW(opname, ...) printf("[WARN][%s] ", opname); printf(__VA_ARGS__); printf("\n");
+#define OP_LOGE_WITHOUT_REPORT(opname, ...) printf("[ERRORx][%s] ", opname); printf(__VA_ARGS__); printf("\n");
+#define OP_LOGE(opname, ...) printf("[ERROR][%s] ", opname); printf(__VA_ARGS__); printf("\n");
