+                            L1Mat<half, ChunkSize, HiddenSize, DYNAMIC, DYNAMIC> _l1(valid_rows, HiddenSize);
+                            TASSIGN(_l1, 32768);
+                            Shape<1, 1, 1, DYNAMIC, DYNAMIC> _gs;
+                            _gs.shape[3] = valid_rows;
+                            _gs.shape[4] = HiddenSize;
