+                            TASSIGN(_l1, 0);
+                            Shape<1, 1, 1, DYNAMIC, DYNAMIC> _gs;
+                            _gs.shape[3] = valid_rows;
+                            _gs.shape[4] = HiddenSize;
+                            GlobalTensor<half, decltype(_gs), Stride<1, 1, 1, BSND_QK_STRIDE, 1>> _gm(Q_handle + qk_off,
+                                                                                                      _gs);
+                            TLOAD(_l1, _gm);
+                            if (valid_rows != ChunkSize) TFILLPAD(_l1, _l1);
