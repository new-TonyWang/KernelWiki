+                        {
+                            L1Mat<half, HiddenSize, HiddenSize, DYNAMIC, DYNAMIC> _l1(HiddenSize, HiddenSize);
+                            TASSIGN(_l1, 65536);
+                            Shape<1, 1, 1, DYNAMIC, DYNAMIC> _gs;
+                            _gs.shape[3] = HiddenSize;
+                            _gs.shape[4] = HiddenSize;
