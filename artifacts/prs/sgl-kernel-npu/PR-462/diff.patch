+                            set_flag(PIPE_MTE2, PIPE_MTE1, _we);
+                            wait_flag(PIPE_MTE2, PIPE_MTE1, _we);
+                            set_flag(PIPE_M, PIPE_MTE1, _we);
+                            wait_flag(PIPE_M, PIPE_MTE1, _we);
