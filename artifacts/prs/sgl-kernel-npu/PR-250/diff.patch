+constexpr uint32_t BLOCK_NUM = 256U / UB_ALIGN;       // BlockReduceMax 256字节对齐，计算每256字节block数量
+constexpr int CAM_MAX_RANK_SIZE = 384;                // cam max rank size
+constexpr int64_t IPC_DATA_OFFSET = 2 * 1024 * 1024;  // first 2MB for flag.
+
