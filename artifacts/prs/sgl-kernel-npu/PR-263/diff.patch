-        for (uint32_t ep = startRankId_; ep < endRankId_; ep++) {
-            if ((ep > 0) || (expertIdx > 0)) {
-                preCount = epSendCountLocal_.GetValue(expertIdx * epWorldSize_ + ep - 1);
