-        // 分核，确定每个核要处理的token
-        uint32_t sendTokenNum = expertIdsCnt / moeUsedAivNum_;
-        uint32_t remainderTokenNum = expertIdsCnt % moeUsedAivNum_;
-        uint32_t startTokenId = sendTokenNum * aivId_;
