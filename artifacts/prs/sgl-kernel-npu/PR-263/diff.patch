-__aicore__ inline void ShmemMoeDistributeDispatch<TemplateMC2TypeFunc>::WaitDispatch()
-{
-    uint32_t rscvStatusNum = isShareExpertRank_ ? epWorldSize_ : recvWinBlockNum_;
