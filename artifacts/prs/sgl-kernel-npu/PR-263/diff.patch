-        uint32_t preSendExpertNum = preTotalExpertNum / aivNum_;
-        uint32_t preRemainderRankNum = preTotalExpertNum % aivNum_;
-        uint32_t preStartExpertId = preSendExpertNum * aivId_;
-        if (aivId_ < preRemainderRankNum) {
-            preSendExpertNum += 1;
