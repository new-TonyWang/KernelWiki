-                }
-                SyncFunc<AscendC::HardEvent::S_MTE3>();
-                expandIdxGMTensor.SetGlobalBuffer(
-                    (__gm__ int32_t *)(expandIdxOutGM_ + row * axisK_ * sizeof(uint32_t)));
-                DataCopy(expandIdxGMTensor, expertCountTensor_[row * axisK_], axisK_);
-            }
-        }
