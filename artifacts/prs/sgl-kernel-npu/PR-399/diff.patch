+__aicore__ inline void OccupyMMTE1Events()
+{
+    if ASCEND_IS_AIC {
+        TPipe* pipe_ptr = GetTPipePtr();
+        pipe_ptr->AllocEventID<HardEvent::M_MTE1>();
+        pipe_ptr->AllocEventID<HardEvent::M_MTE1>();
+        pipe_ptr->AllocEventID<HardEvent::M_MTE1>();
+    }
+}
