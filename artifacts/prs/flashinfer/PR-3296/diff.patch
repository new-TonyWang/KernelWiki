+        )
+        kc_latent_smem_layout_for_tma = cute.logical_divide(
+            kc_latent_smem_layout_for_tma, (None, None, None, self.iterations_qk_latent)
+        )
+
+        kc_rope_smem_layout_staged = sm100_utils.make_smem_layout_b(
