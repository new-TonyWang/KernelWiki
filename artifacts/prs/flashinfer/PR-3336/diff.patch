+        fc1_tile_n,
+        fc1_tile_k,
+        fc2_tile_n,
+        fc2_tile_k,
+        moe_block_size,
+        max_m_blocks,
+    )
+    cached = _FUSED_CACHE.get(cache_key)
+    if cached is not None:
