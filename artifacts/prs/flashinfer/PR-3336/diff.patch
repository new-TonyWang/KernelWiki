+    ):
+        d0, d1, d2, d3 = self._mma_rhs_fragments_as_mma_a_m16n8k16_f32(
+            acc[jj, 0],
+            acc[jj, 1],
+            acc[jj, 2],
+            acc[jj, 3],
+            b_frag[0, 0],
+            b_frag[1, 0],
+            b_frag[0, 1],
+            b_frag[1, 1],
+            a_regs[0],
+            a_regs[1],
+        )
+        acc[jj, 0] = d0
+        acc[jj, 1] = d1
+        acc[jj, 2] = d2
+        acc[jj, 3] = d3
