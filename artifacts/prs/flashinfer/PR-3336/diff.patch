+        (num_experts * (hidden_size // 16) * (fc1_cols // 4),),
+        assumed_align=16,
+    )
+    w2_scales_fake = cute.runtime.make_fake_compact_tensor(
+        cutlass.Int32,
+        (num_experts * (intermediate_size // 16) * (hidden_size // 4),),
+        assumed_align=16,
