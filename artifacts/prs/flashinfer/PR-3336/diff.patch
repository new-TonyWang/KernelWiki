+            if has_work != Int32(0):
+                if in_tail_region == Int32(0):
+                    work_mn_tile += grid_x
+                else:
+                    reduce_k_tile = Int32(0)
+                    work_mn_tile += Int32(1)
+                    output_n_tile += Int32(1)
+                    if output_n_tile == n_tiles:
+                        output_n_tile = Int32(0)
+                        route_block_idx += Int32(1)
