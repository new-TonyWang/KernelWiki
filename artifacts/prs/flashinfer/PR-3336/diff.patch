+    w13_global_fake = cute.runtime.make_fake_compact_tensor(
+        cutlass.Float32,
+        (num_experts,),
+        assumed_align=16,
+    )
+    w2_global_fake = cute.runtime.make_fake_compact_tensor(
+        cutlass.Float32,
+        (num_experts,),
+        assumed_align=16,
