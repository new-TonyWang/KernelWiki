+            a_regs[mb, 1],
+            a_regs[mb, 2],
+            a_regs[mb, 3],
+            b_frag[0, 0],
+            b_frag[0, 1],
+        )
+        acc[mb, jj, 0, 0] = d0
+        acc[mb, jj, 0, 1] = d1
+        acc[mb, jj, 0, 2] = d2
+        acc[mb, jj, 0, 3] = d3
+        d0, d1, d2, d3 = self._mma_m16n8k16_f32(
+            acc[mb, jj, 1, 0],
+            acc[mb, jj, 1, 1],
+            acc[mb, jj, 1, 2],
+            acc[mb, jj, 1, 3],
+            a_regs[mb, 0],
+            a_regs[mb, 1],
+            a_regs[mb, 2],
+            a_regs[mb, 3],
+            b_frag[1, 0],
+            b_frag[1, 1],
+        )
+        acc[mb, jj, 1, 0] = d0
+        acc[mb, jj, 1, 1] = d1
+        acc[mb, jj, 1, 2] = d2
