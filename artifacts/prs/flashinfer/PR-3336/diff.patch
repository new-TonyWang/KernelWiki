+        return broadcast_f32_to_bfloat2(x)
+
+    @cute.jit
+    def _pack_f32x2_to_elem2(self, x0: cutlass.Float32, x1: cutlass.Float32) -> Uint32:
+        if cutlass.const_expr(self.is_fp16):
