+        cur_group_id = Int32(self.b_sh_wr_iters) * warp_row + kk
+        s_addr = (
+            smem_base
+            + Int32(self.sh_s_off * 16)
+            + pipe * Int32(self.s_sh_stage * 16)
+            + (s_sh_rd + cur_group_id * Int32(2 * self.s_sh_stride)) * Int32(8)
