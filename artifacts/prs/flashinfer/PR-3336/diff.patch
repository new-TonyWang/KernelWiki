+                    r0, r1, r2, r3 = ld_shared_v4_f32(rd_addr)
+                    acc[jj, 0] = acc[jj, 0] + r0
+                    acc[jj, 1] = acc[jj, 1] + r1
+                    acc[jj, 2] = acc[jj, 2] + r2
+                    acc[jj, 3] = acc[jj, 3] + r3
