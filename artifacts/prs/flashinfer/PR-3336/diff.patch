+
+    @cute.jit
+    def __call__(
+        self,
+        a_bf16_flat: cute.Tensor,
+        w13_i32_flat: cute.Tensor,
+        w2_i32_flat: cute.Tensor,
+        fc1_bf16_flat: cute.Tensor,
+        activated_bf16_flat: cute.Tensor,
+        fc2_bf16_flat: cute.Tensor,
