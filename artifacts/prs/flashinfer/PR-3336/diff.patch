+                f"{fc1_cta_threads} vs {fc2_cta_threads}"
+            )
+    cache_key = (
+        "w4a16_fused_moe",
+        device,
+        sms,
+        max_shared_mem,
+        element_dtype,
+        size_m,
+        hidden_size,
+        intermediate_size,
+        num_experts,
+        top_k,
+        activation,
