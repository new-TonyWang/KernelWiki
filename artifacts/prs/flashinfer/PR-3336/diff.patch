+                        acc[jj, 1] = acc[jj, 1] + r1 + w1
+                        acc[jj, 2] = acc[jj, 2] + r2 + w2
+                        acc[jj, 3] = acc[jj, 3] + r3 + w3
+                    st_shared_v4_f32(
+                        self._int4_addr(smem_base, Int32(self.sh_red_off) + red_sh_wr),
+                        acc[jj, 0],
+                        acc[jj, 1],
+                        acc[jj, 2],
+                        acc[jj, 3],
