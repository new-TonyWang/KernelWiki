+                        st_shared_v4_f32(
+                            self._int4_addr(
+                                smem_base, Int32(self.sh_red_off) + red_sh_wr
+                            ),
+                            acc[jj, 0],
+                            acc[jj, 1],
+                            acc[jj, 2],
+                            acc[jj, 3],
+                        )
+                cute.arch.sync_threads()
+
+            if Int32(1) <= red_idx and red_idx < Int32(2):
