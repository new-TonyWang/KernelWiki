+    @cute.jit
+    def _load_b_scale_registers(
+        self,
+        smem_base: Int32,
+        tid: Int32,
+        b_sh_rd: Int32,
+        s_sh_rd: Int32,
+        pipe: Int32,
+        kk: Int32,
