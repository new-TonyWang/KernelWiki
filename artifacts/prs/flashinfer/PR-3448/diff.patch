+@cute.jit
+def _pack_f32x16_to_e2m1(values: tuple) -> tuple:
+    packed_lo = cvt_e2m1x8_f32(
+        values[0],
+        values[1],
+        values[2],
+        values[3],
+        values[4],
+        values[5],
+        values[6],
+        values[7],
+    )
+    packed_hi = cvt_e2m1x8_f32(
+        values[8],
+        values[9],
+        values[10],
+        values[11],
+        values[12],
+        values[13],
+        values[14],
+        values[15],
+    )
+    packed64 = (Uint64(packed_hi) << Uint64(32)) | Uint64(packed_lo)
+    return packed_lo, packed_hi, packed64
