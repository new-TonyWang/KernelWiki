+    # are exactly representable in fp16, so RN does not need a tie path here.
+    log2_sig = torch.zeros_like(product_sig)
+    for threshold in (2, 4, 8, 16, 32, 64, 128, 256):
+        log2_sig = log2_sig + (product_sig >= threshold).to(torch.int32)
