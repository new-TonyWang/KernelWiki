+                m, o_partial, l_partial, m_partial = _slice_workspace(
+                    self._float_workspace_buffer,
+                    self._kv_splits,
+                    self._batch_size,
+                    q_len_per_req,
+                    self._num_qo_heads,
+                    self._head_dim,
+                )
