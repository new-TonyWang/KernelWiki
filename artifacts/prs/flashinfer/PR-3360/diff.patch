+
+        ##############################
+        # MMA KQ (BMM1) Dispatch
+        ##############################
+        elif warp_idx == mma_kq_warp_id:
+            # Free registers
+            if cutlass.const_expr(use_reg_reconfig):
+                cute.arch.setmaxregister_decrease(mma_tma_regs)
+
+            # Setup mma descriptors
