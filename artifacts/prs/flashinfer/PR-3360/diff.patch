+                tma_atom_k,
+                mcast_coord,
+                mcast_layout,
+                smem_tensor=cute.group_modes(tAsK, 0, 3),
+                gmem_tensor=cute.group_modes(tAgK, 0, 3),
+            )
+
+            tGSsV, tGSgV = cute.nvgpu.cpasync.tma_partition(
+                tma_atom_v,
+                mcast_coord,
+                mcast_layout,
+                smem_tensor=cute.group_modes(tAsV, 0, 3),
+                gmem_tensor=cute.group_modes(tAgV, 0, 3),
