+                mma_order_kq_nbar.arrive()
+
+        ##############################
+        # MMA VP (BMM2) Dispatch
+        ##############################
+        elif warp_idx == mma_vp_warp_id:
+            # Free registers
+            if cutlass.const_expr(use_reg_reconfig):
+                cute.arch.setmaxregister_decrease(mma_tma_regs)
+
