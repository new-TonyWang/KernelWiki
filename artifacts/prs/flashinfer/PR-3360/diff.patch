+            # (TILE_H, TILE_D)
+            gQ = cute.local_tile(
+                mQ,
+                tiler=(blk_tile_hp, blk_tile_d),
+                coord=(coord_hp, 0, coord_hb),
+            )
+            # Apply MMA tiler and MMA partition
+            # (MMA_TILE_N, MMA_TILE_K, #TILE_HN=1, #TILE_DK)
