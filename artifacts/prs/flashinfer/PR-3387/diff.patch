+    fp8_val: Uint32, global_scale: Float32, block_amax: Float32, *, loc=None, ip=None
+) -> Float32:
+    """Compute TE-exact NVFP4 output scale when FP4 quant fast math is disabled."""
+    return Float32(
+        llvm.inline_asm(
+            T.f32(),
+            [
