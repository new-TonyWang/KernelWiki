+                div.rn.f32 rcp_gs, 0f3F800000, $2;
+                mul.rn.f32 product, scale_f32, rcp_gs;
+                div.rn.f32 result, 0f3F800000, product;
+                mov.b32 max_f32, 0x7F7FFFFF;
+                min.f32 result, result, max_f32;
