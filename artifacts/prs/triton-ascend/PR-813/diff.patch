+def scatter_1d_kernel(value_ptr, index_ptr, dst_ptr, dst_dim0: tl.constexpr):
+    i = tl.arange(0, dst_dim0)
+    mask = i < dst_dim0
+    val = tl.load(value_ptr + i, mask=mask)
+    idx = tl.load(index_ptr + i, mask=mask)
+    scatter_ub_to_out(
+        ptr=dst_ptr,
+        value=val,
+        index_tile=idx,
+        index_boundary=dst_dim0,
+        dim=0,
+        num_dims=1,
