diff --git a/ascend/examples/temp_cases/index_put_example.py b/ascend/examples/temp_cases/index_put_example.py
@@ -0,0 +1,44 @@
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.ascend.libdevice import index_put
+
+@triton.jit
+def simple_index_put_kernel(value_ptr, index_ptr, dst_ptr):
+    # index tile shape: [2]
+    index_local = tl.arange(0, 2)
+    x1_local = tl.arange(0, 2)[None, :]  # shape=(1,2)
+
+    index_tile = tl.load(index_ptr + index_local)
+    value_tile = tl.load(value_ptr + index_local[:, None]*2 + x1_local)
+
+    index_put(
+        ptr=dst_ptr,
+        index=index_tile,
+        value=value_tile,
+        dim=0,
+        dst_shape=(4, 2),
+        dst_offset=(0, 0)
+    )
+
+def torch_index_put_eager_(dst: torch.Tensor, value: torch.Tensor, index_1d: torch.Tensor, dim: int=0):
+    # 将 1D index 扩展到 value.shape，然后在 dim 维 scatter_ 覆盖赋值
+    shape = list(value.shape)
+    view = [1] * value.ndim
+    view[dim] = shape[dim]
+    idx_expanded = index_1d.view(view).expand(shape)
+    out = dst.clone()
+    out.scatter_(dim, idx_expanded, value)
+    return out
+
+dst = torch.zeros((4,2), device='npu', dtype=torch.float32)
+value = torch.tensor([[1.,2.], [3.,4.]], device='npu')
+index = torch.tensor([2, 0], device='npu')
+
+torch_ref = torch_index_put_eager_(dst, value, index)
+# print("torch_ref", torch_ref)
+
+simple_index_put_kernel[(1,)](value, index, dst)
+# print("IndexPut result:", dst) # ref:[[3.,4.], [0.,0.], [1.,2.], [0.,0.]]
+
+torch.testing.assert_close(dst, torch_ref)
