diff --git a/ascend/examples/temp_cases/index_put_n.py b/ascend/examples/temp_cases/index_put_n.py
@@ -0,0 +1,225 @@
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.ascend.libdevice import index_put
+
+import pytest
+
+# -------------------------- 2D Kernel --------------------------
+@triton.jit
+def index_put_2d_kernel(
+    value_ptr, index_ptr, dst_ptr,
+    dst_dim0: tl.constexpr, dst_dim1: tl.constexpr,
+    val_dim0: tl.constexpr, val_dim1: tl.constexpr,
+    put_dim: tl.constexpr
+):
+    # 生成2D坐标
+    i = tl.arange(0, val_dim0)[:, None]
+    j = tl.arange(0, val_dim1)[None, :]
+    mask = (i < val_dim0) & (j < val_dim1)
+
+    # 计算 value 偏移（行主序）
+    value_offset = i * val_dim1 + j
+    value_tile = tl.load(value_ptr + value_offset, mask=mask)
+
+    # 加载 1D index（沿 dim 的长度）
+    line = tl.arange(0, val_dim0 if put_dim == 0 else val_dim1)
+    index_tile = tl.load(index_ptr + line)
+
+    # 写入
+    index_put(
+        ptr=dst_ptr,
+        index=index_tile,
+        value=value_tile,
+        dim=put_dim,
+        dst_shape=(dst_dim0, dst_dim1),
+        dst_offset=(0, 0)
+    )
+
+# -------------------------- 3D Kernel --------------------------
+@triton.jit
+def index_put_3d_kernel(
+    value_ptr, index_ptr, dst_ptr,
+    dst_dim0: tl.constexpr, dst_dim1: tl.constexpr, dst_dim2: tl.constexpr,
+    val_dim0: tl.constexpr, val_dim1: tl.constexpr, val_dim2: tl.constexpr,
+    put_dim: tl.constexpr
+):
+    a = tl.arange(0, val_dim0)[:, None, None]
+    b = tl.arange(0, val_dim1)[None, :, None]
+    c = tl.arange(0, val_dim2)[None, None, :]
+    mask = (a < val_dim0) & (b < val_dim1) & (c < val_dim2)
+
+    value_offset = a * (val_dim1 * val_dim2) + b * val_dim2 + c
+    value_tile = tl.load(value_ptr + value_offset, mask=mask)
+
+    line = tl.arange(0, val_dim0 if put_dim == 0 else (val_dim1 if put_dim == 1 else val_dim2))
+    index_tile = tl.load(index_ptr + line)
+
+    index_put(
+        ptr=dst_ptr,
+        index=index_tile,
+        value=value_tile,
+        dim=put_dim,
+        dst_shape=(dst_dim0, dst_dim1, dst_dim2),
+        dst_offset=(0, 0, 0)
+    )
+
+# -------------------------- 4D Kernel --------------------------
+@triton.jit
+def index_put_4d_kernel(
+    value_ptr, index_ptr, dst_ptr,
+    dst_dim0: tl.constexpr, dst_dim1: tl.constexpr, dst_dim2: tl.constexpr, dst_dim3: tl.constexpr,
+    val_dim0: tl.constexpr, val_dim1: tl.constexpr, val_dim2: tl.constexpr, val_dim3: tl.constexpr,
+    put_dim: tl.constexpr
+):
+    n = tl.arange(0, val_dim0)[:, None, None, None]
+    z = tl.arange(0, val_dim1)[None, :, None, None]
+    y = tl.arange(0, val_dim2)[None, None, :, None]
+    x = tl.arange(0, val_dim3)[None, None, None, :]
+    mask = (n < val_dim0) & (z < val_dim1) & (y < val_dim2) & (x < val_dim3)
+
+    value_offset = n * (val_dim1 * val_dim2 * val_dim3) + z * (val_dim2 * val_dim3) + y * val_dim3 + x
+    value_tile = tl.load(value_ptr + value_offset, mask=mask)
+
+    line = tl.arange(0, (val_dim0 if put_dim == 0 else (val_dim1 if put_dim == 1 else (val_dim2 if put_dim == 2 else val_dim3))))
+    index_tile = tl.load(index_ptr + line)
+
+    index_put(
+        ptr=dst_ptr,
+        index=index_tile,
+        value=value_tile,
+        dim=put_dim,
+        dst_shape=(dst_dim0, dst_dim1, dst_dim2, dst_dim3),
+        dst_offset=(0, 0, 0, 0)
+    )
+
+# -------------------------- 5D Kernel --------------------------
+@triton.jit
+def index_put_5d_kernel(
+    value_ptr, index_ptr, dst_ptr,
+    dst_dim0: tl.constexpr, dst_dim1: tl.constexpr, dst_dim2: tl.constexpr, dst_dim3: tl.constexpr, dst_dim4: tl.constexpr,
+    val_dim0: tl.constexpr, val_dim1: tl.constexpr, val_dim2: tl.constexpr, val_dim3: tl.constexpr, val_dim4: tl.constexpr,
+    put_dim: tl.constexpr
+):
+    b = tl.arange(0, val_dim0)[:, None, None, None, None]
+    c = tl.arange(0, val_dim1)[None, :, None, None, None]
+    d = tl.arange(0, val_dim2)[None, None, :, None, None]
+    h = tl.arange(0, val_dim3)[None, None, None, :, None]
+    w = tl.arange(0, val_dim4)[None, None, None, None, :]
+    mask = (b < val_dim0) & (c < val_dim1) & (d < val_dim2) & (h < val_dim3) & (w < val_dim4)
+
+    value_offset = (
+        b * (val_dim1 * val_dim2 * val_dim3 * val_dim4)
+        + c * (val_dim2 * val_dim3 * val_dim4)
+        + d * (val_dim3 * val_dim4)
+        + h * val_dim4
+        + w
+    )
+    value_tile = tl.load(value_ptr + value_offset, mask=mask)
+
+    line = tl.arange(0, (val_dim0 if put_dim == 0 else (val_dim1 if put_dim == 1 else (val_dim2 if put_dim == 2 else (val_dim3 if put_dim == 3 else val_dim4)))))
+    index_tile = tl.load(index_ptr + line)
+
+    index_put(
