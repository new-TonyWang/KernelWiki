+        index_tile=idx,
+        index_boundary=(d0 if dim == 0 else (d1 if dim == 1 else d2)),
+        dim=dim,
+        num_dims=3,
+        dst_stride=(d1 * d2, d2, 1),
+        index_tile_shape=(v0, v1, v2),
+        index_shape=(v0, v1, v2),
+        offsets=(0, 0, 0)
+    )
