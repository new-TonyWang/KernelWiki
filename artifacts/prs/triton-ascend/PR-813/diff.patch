+    沿dim=0执行Scatter操作, 将value按index scatter到dst中
+    dst[index[i][j]][j] = value[i][j]
+    """
+    # 当前Program处理的Y维度全局偏移
+    y0_offset = tl.program_id(0) * Y0BLOCK
+    # 构造Y/X维度的局部索引基值（子Tile大小）
+    base_y0 = tl.arange(0, Y0BLOCK_SUB)
+    loops_y0 = (Y0BLOCK + Y0BLOCK_SUB - 1) // Y0BLOCK_SUB  # Y维度循环次数
+    base_x1 = tl.arange(0, X1BLOCK_SUB)
+    loops_x1 = (x1_numel + X1BLOCK_SUB - 1) // X1BLOCK_SUB  # X维度循环次数
+
+    for loop_y0 in range(loops_y0):
+        # 计算Y维度全局索引（当前子Tile）
+        y0 = y0_offset + (loop_y0 * Y0BLOCK_SUB) + base_y0[:, None]
+        y0_mask = y0 < min(Y0BLOCK + y0_offset, y0_numel)  # Y维度越界mask
+        
+        for loop_x1 in range(loops_x1):
+            # 计算X维度全局索引（当前子Tile）
+            x1 = (loop_x1 * X1BLOCK_SUB) + base_x1[None, :]
+            x1_mask = x1 < x1_numel  # X维度越界mask
+            tile_mask = y0_mask & x1_mask
+
+            # 1. 加载当前Tile的value（UB中）
+            value_tile = tl.load(value_ptr + (x1 + 1080 * y0), tile_mask)
+            # 2. 加载当前Tile的index（UB中）
+            index_tile = tl.load(index_ptr + (x1 + 1080 * y0), tile_mask)
+
+            # 3. 调用scatter_ub_to_out：将value_tile按index_tile scatter到dst（GM）
+            libdevice.scatter_ub_to_out(
+                ptr=dst_ptr,                  # 目标张量（GM）
+                value=value_tile,             # 待scatter的value tile（UB）
+                index_tile=index_tile,             # 索引tile（UB）
+                index_boundary=1920,          # 目标张量dim=0的大小（索引上界）
+                dim=0,                        # 沿dim=0 scatter
+                num_dims=2,
+                dst_stride=(1080, 1),         # 目标张量的步长
+                index_tile_shape=(Y0BLOCK_SUB, X1BLOCK_SUB),  # 索引tile的shape
+                index_shape=(y0_numel, x1_numel),  # 原始索引张量的shape
+                offsets=(y0_offset + (loop_y0 * Y0BLOCK_SUB), (loop_x1 * X1BLOCK_SUB))  # 当前Tile的偏移
+            )
+
+
+def eager_func(dst, value, indices):
+    return torch.ops.aten.scatter(dst, 0, indices, value)
+
+
+dst = torch.zeros((1920, 1080), device='npu', dtype=torch.float32)
+value = rand_strided((1920, 1080), (1080, 1), device='npu', dtype=torch.float32)
+indices = torch.randint(0, 1920, (1920, 1080), device='npu')
+print(">> dst shape:", dst.shape, "stride:", dst.stride())
+print(">> value shape:", value.shape, "stride:", value.stride())
+print(">> indices shape:", indices.shape, "stride:", indices.stride())
+torch_ref = eager_func(dst.clone(), value, indices)
+print(">> torch_ref shape:", torch_ref.shape, "stride:", torch_ref.stride())
+print(">> torch_ref:", torch_ref)
+buf0 = empty_strided((1920, 1080), (1080, 1), device='npu', dtype=torch.float32)
+
+triton_unk_fused_scatter_0[(56,)](
