diff --git a/ascend/examples/temp_cases/test_gather_out_to_ub.py b/ascend/examples/temp_cases/test_gather_out_to_ub.py
@@ -0,0 +1,48 @@
+import torch
+from torch import empty_strided
+from torch._dynamo.testing import rand_strided
+import triton
+import triton.language as tl
+import triton.language.extra.ascend.libdevice as libdevice
+
+
+@triton.jit
+def triton_unk_fused_gather_0(
+    in_ptr0, in_ptr1, out_ptr0,
+    y0_numel, x1_numel, Y0BLOCK: tl.constexpr,
+    Y0BLOCK_SUB: tl.constexpr, X1BLOCK_SUB: tl.constexpr
+    ):
+    y0_offset = tl.program_id(0) * Y0BLOCK
+    base_y0 = tl.arange(0, Y0BLOCK_SUB)
+    loops_y0 = (Y0BLOCK + Y0BLOCK_SUB - 1) // Y0BLOCK_SUB
+    base_x1 = tl.arange(0, X1BLOCK_SUB)
+    loops_x1 = (x1_numel + X1BLOCK_SUB - 1) // X1BLOCK_SUB
+    for loop_y0 in range(loops_y0):
+        y0 = y0_offset + (loop_y0 * Y0BLOCK_SUB) + base_y0[:, None]
+        y0_mask = y0 < min(Y0BLOCK+y0_offset, y0_numel)
+        for loop_x1 in range(loops_x1):
+            x1 = (loop_x1 * X1BLOCK_SUB) + base_x1[None, :]
+            x1_mask = x1 < x1_numel
+            tmp0 = tl.load(in_ptr0 + (x1+1080*y0), y0_mask & x1_mask)
+            tmp1 = tl.load(in_ptr0 + (x1+1080*tmp0), y0_mask & x1_mask)
+            tmp2 = libdevice.gather_out_to_ub(
+                in_ptr1, tmp1, 1920, 0, (1080, 1), (y0_numel, x1_numel),
+                (y0_offset + (loop_y0 * Y0BLOCK_SUB), (loop_x1 * X1BLOCK_SUB)))
+            tl.store(out_ptr0 + (x1 + 1080*y0), tmp2, y0_mask & x1_mask)
+
+
+def eager_func(input, indices):
+    return torch.ops.aten.gather(input, 0, indices)
+
+arg0_1 = torch.randint(0, 1920, (1920, 1080), device='npu')
+arg1_1 = rand_strided((1920, 1080), (1080, 1), device='npu', dtype=torch.float32)
+print(">> arg0_1 shape:", arg0_1.shape, "stride:", arg0_1.stride())
+print(">> arg1_1 shape:", arg1_1.shape, "stride:", arg1_1.stride())
+torch_ref = eager_func(arg1_1, arg0_1)
+print(">> torch_ref shape:", torch_ref.shape, "stride:", torch_ref.stride())
+print(">> torch_ref:", torch_ref)
+buf0 = empty_strided((1920, 1080), (1080, 1), device='npu', dtype=torch.float32)
+triton_unk_fused_gather_0[(56,)](arg0_1, arg1_1, buf0, 1920, 1080, 34, 16, 1080)
+
+torch.testing.assert_close(buf0, torch_ref)
+print("Test passed!")

