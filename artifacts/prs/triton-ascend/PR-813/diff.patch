+    z = tl.arange(0, v1)[None, :, None, None]
+    y = tl.arange(0, v2)[None, None, :, None]
+    x = tl.arange(0, v3)[None, None, None, :]
+    mask = (n < v0) & (z < v1) & (y < v2) & (x < v3)
+    val = tl.load(value_ptr + n * (v1*v2*v3) + z * (v2*v3) + y * v3 + x, mask=mask)
+    idx = tl.load(index_ptr + n * (v1*v2*v3) + z * (v2*v3) + y * v3 + x, mask=mask)
+    scatter_ub_to_out(
