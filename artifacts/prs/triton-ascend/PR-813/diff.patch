+# -------------------------- PyTorch eager 参考（scatter_ 等价） --------------------------
+def torch_index_put_eager(dst: torch.Tensor, value: torch.Tensor, index_1d: torch.Tensor, dim: int):
+    # 将 1D index 扩展到 value.shape，然后在 dim 维 scatter_ 覆盖赋值
+    shape = list(value.shape)
+    view = [1] * value.ndim
+    view[dim] = shape[dim]
+    idx_expanded = index_1d.view(view).expand(shape)
+    out = dst.clone()
+    out.scatter_(dim, idx_expanded, value)
