diff --git a/ascend/examples/temp_cases/gather_example_n.py b/ascend/examples/temp_cases/gather_example_n.py
@@ -0,0 +1,225 @@
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.ascend.libdevice import gather_out_to_ub
+
+import pytest
+
+# -------------------------- 2D专用Kernel --------------------------
+@triton.jit
+def gather_2d_kernel(
+    src_ptr, index_ptr, out_ptr,
+    src_dim0: tl.constexpr, src_dim1: tl.constexpr,
+    out_dim0: tl.constexpr, out_dim1: tl.constexpr,
+    gather_dim: tl.constexpr
+):
+    # 生成2D局部坐标（y:行，x:列）
+    y_local = tl.arange(0, out_dim0)[:, None]  
+    x_local = tl.arange(0, out_dim1)[None, :]  
+    mask = (y_local < out_dim0) & (x_local < out_dim1)
+    
+    # 计算2D索引偏移（原生多维存储逻辑）
+    index_offset = y_local * out_dim1 + x_local
+    index_tile = tl.load(index_ptr + index_offset, mask=mask)
+    
+    gathered = gather_out_to_ub(
+        src=src_ptr,
+        index_tile=index_tile,
+        index_boundary=src_dim0 if gather_dim == 0 else src_dim1,
+        dim=gather_dim,
+        src_stride=(src_dim1, 1),
+        index_shape=(out_dim0, out_dim1),
+        offsets=(0, 0)
+    )
+    
+    # 存储结果（2D偏移）
+    out_offset = y_local * out_dim1 + x_local
+    tl.store(out_ptr + out_offset, gathered, mask=mask)
+
+# -------------------------- 3D专用Kernel --------------------------
+@triton.jit
+def gather_3d_kernel(
+    src_ptr, index_ptr, out_ptr,
+    src_dim0: tl.constexpr, src_dim1: tl.constexpr, src_dim2: tl.constexpr,
+    out_dim0: tl.constexpr, out_dim1: tl.constexpr, out_dim2: tl.constexpr,
+    gather_dim: tl.constexpr
+):
+    # 生成3D局部坐标（z:深度，y:行，x:列）
+    z_local = tl.arange(0, out_dim0)[:, None, None]  
+    y_local = tl.arange(0, out_dim1)[None, :, None]  
+    x_local = tl.arange(0, out_dim2)[None, None, :]  
+    mask = (z_local < out_dim0) & (y_local < out_dim1) & (x_local < out_dim2)
+    
+    # 计算3D索引偏移（原生多维存储逻辑：z*dim1*dim2 + y*dim2 + x）
+    index_offset = z_local * out_dim1 * out_dim2 + y_local * out_dim2 + x_local
+    index_tile = tl.load(index_ptr + index_offset, mask=mask)
+    
+    gathered = gather_out_to_ub(
+        src=src_ptr,
+        index_tile=index_tile,
+        index_boundary=src_dim0,
+        dim=gather_dim,
+        src_stride=(src_dim1*src_dim2, src_dim2, 1),
+        index_shape=(out_dim0, out_dim1, out_dim2),
+        offsets=(0, 0, 0)
+    )
+    
+    # 存储结果（3D偏移）
+    out_offset = z_local * out_dim1 * out_dim2 + y_local * out_dim2 + x_local
+    tl.store(out_ptr + out_offset, gathered, mask=mask)
+
+
+# -------------------------- 4D专用Kernel --------------------------
+@triton.jit
+def gather_4d_kernel(
+    src_ptr, index_ptr, out_ptr,
+    src_dim0: tl.constexpr, src_dim1: tl.constexpr, src_dim2: tl.constexpr, src_dim3: tl.constexpr,
+    out_dim0: tl.constexpr, out_dim1: tl.constexpr, out_dim2: tl.constexpr, out_dim3: tl.constexpr,
+    gather_dim: tl.constexpr
+):
+    # 生成4D局部坐标（n: batch，z:深度，y:行，x:列）
+    n_local = tl.arange(0, out_dim0)[:, None, None, None]  
+    z_local = tl.arange(0, out_dim1)[None, :, None, None]  
+    y_local = tl.arange(0, out_dim2)[None, None, :, None]  
+    x_local = tl.arange(0, out_dim3)[None, None, None, :]  
+    mask = (n_local < out_dim0) & (z_local < out_dim1) & (y_local < out_dim2) & (x_local < out_dim3)
+    
+    # 计算4D索引偏移（原生多维存储：n*dim1*dim2*dim3 + z*dim2*dim3 + y*dim3 + x）
+    index_offset = n_local * out_dim1*out_dim2*out_dim3 + z_local * out_dim2*out_dim3 + y_local * out_dim3 + x_local
+    index_tile = tl.load(index_ptr + index_offset, mask=mask)
+    
+    gathered = gather_out_to_ub(
+        src=src_ptr,
+        index_tile=index_tile,
+        index_boundary=src_dim0,
+        dim=gather_dim,
+        src_stride=(src_dim1*src_dim2*src_dim3, src_dim2*src_dim3, src_dim3, 1),
+        index_shape=(out_dim0, out_dim1, out_dim2, out_dim3),
+        offsets=(0, 0, 0, 0)
+    )
+    
+    # 存储结果（4D偏移）
+    out_offset = n_local * out_dim1*out_dim2*out_dim3 + z_local * out_dim2*out_dim3 + y_local * out_dim3 + x_local
+    tl.store(out_ptr + out_offset, gathered, mask=mask)
+
+
+# -------------------------- 5D专用Kernel --------------------------
+@triton.jit
+def gather_5d_kernel(
+    src_ptr, index_ptr, out_ptr,
+    src_dim0: tl.constexpr, src_dim1: tl.constexpr, src_dim2: tl.constexpr, src_dim3: tl.constexpr, src_dim4: tl.constexpr,
+    out_dim0: tl.constexpr, out_dim1: tl.constexpr, out_dim2: tl.constexpr, out_dim3: tl.constexpr, out_dim4: tl.constexpr,
+    gather_dim: tl.constexpr
+):
+    # 生成5D局部坐标（b: batch，c: channel，d: depth，h: height，w: width）
+    b_local = tl.arange(0, out_dim0)[:, None, None, None, None]  
+    c_local = tl.arange(0, out_dim1)[None, :, None, None, None]  
+    d_local = tl.arange(0, out_dim2)[None, None, :, None, None]  
+    h_local = tl.arange(0, out_dim3)[None, None, None, :, None]  
+    w_local = tl.arange(0, out_dim4)[None, None, None, None, :]  
+    mask = (b_local < out_dim0) & (c_local < out_dim1) & (d_local < out_dim2) & (h_local < out_dim3) & (w_local < out_dim4)
+    
+    # 计算5D索引偏移（原生多维存储：b*dim1*dim2*dim3*dim4 + c*dim2*dim3*dim4 + d*dim3*dim4 + h*dim4 + w）
+    index_offset = b_local * out_dim1*out_dim2*out_dim3*out_dim4 + c_local * out_dim2*out_dim3*out_dim4 + d_local * out_dim3*out_dim4 + h_local * out_dim4 + w_local
+    index_tile = tl.load(index_ptr + index_offset, mask=mask)
+
+    gathered = gather_out_to_ub(
+        src=src_ptr,
+        index_tile=index_tile,
+        index_boundary=src_dim0,
+        dim=gather_dim,
+        src_stride=(src_dim1*src_dim2*src_dim3*src_dim4, src_dim2*src_dim3*src_dim4, src_dim3*src_dim4, src_dim4, 1),
+        index_shape=(out_dim0, out_dim1, out_dim2, out_dim3, out_dim4),
+        offsets=(0, 0, 0, 0, 0)
+    )
+    
+    # 存储结果（5D偏移）
+    out_offset = b_local * out_dim1*out_dim2*out_dim3*out_dim4 + c_local * out_dim2*out_dim3*out_dim4 + d_local * out_dim3*out_dim4 + h_local * out_dim4 + w_local
+    tl.store(out_ptr + out_offset, gathered, mask=mask)
+
+
+@pytest.mark.parametrize("src_shape, out_shape, gather_dim", [((5, 4), (3, 4), 0)])
+def test_gather_2d(src_shape, out_shape, gather_dim):
+    # 生成测试数据
+    src = torch.arange(src_shape[0]*src_shape[1], device='npu', dtype=torch.float32).reshape(src_shape)
+    index = torch.randint(0, src_shape[gather_dim], out_shape, device='npu', dtype=torch.int64)
+    out = torch.empty(out_shape, device='npu', dtype=torch.float32)
+
+    # 启动2D专用Kernel
+    gather_2d_kernel[(1,)](
+        src, index, out,
+        src_dim0=src_shape[0], src_dim1=src_shape[1],
+        out_dim0=out_shape[0], out_dim1=out_shape[1],
+        gather_dim=gather_dim
+    )
+
+    # 验证（PyTorch原生2D gather）
+    ref_out = torch.ops.aten.gather(src, gather_dim, index)
+    torch.testing.assert_close(out, ref_out)
+    print("2D gather结果:\n", out)
+    print("验证通过!\n")
+
+
+@pytest.mark.parametrize("src_shape, out_shape, gather_dim", [((4, 3, 2), (4, 2, 2), 0)])
+def test_gather_3d(src_shape, out_shape, gather_dim):
+    # 生成测试数据
+    src = torch.arange(src_shape[0]*src_shape[1]*src_shape[2], device='npu', dtype=torch.float32).reshape(src_shape)
+    index = torch.randint(0, src_shape[gather_dim], out_shape, device='npu', dtype=torch.int64)
+    out = torch.empty(out_shape, device='npu', dtype=torch.float32)
+
+    # 启动3D专用Kernel
+    gather_3d_kernel[(1,)](
+        src, index, out,
+        src_dim0=src_shape[0], src_dim1=src_shape[1], src_dim2=src_shape[2],
+        out_dim0=out_shape[0], out_dim1=out_shape[1], out_dim2=out_shape[2],
+        gather_dim=gather_dim
+    )
+
+    # 验证（PyTorch原生3D gather）
+    ref_out = torch.ops.aten.gather(src, gather_dim, index)
+    torch.testing.assert_close(out, ref_out)
+    print("3D gather结果:\n", out)
+    print("验证通过!\n")
+
+
+@pytest.mark.parametrize("src_shape, out_shape, gather_dim", [((2, 3, 4, 5), (2, 3, 2, 5), 0)])
+def test_gather_4d(src_shape, out_shape, gather_dim):
+    # 生成测试数据
+    src = torch.arange(src_shape[0]*src_shape[1]*src_shape[2]*src_shape[3], device='npu', dtype=torch.float32).reshape(src_shape)
+    index = torch.randint(0, src_shape[gather_dim], out_shape, device='npu', dtype=torch.int64)
+    out = torch.empty(out_shape, device='npu', dtype=torch.float32)
+
+    # 启动4D专用Kernel
+    gather_4d_kernel[(1,)](
+        src, index, out,
+        src_dim0=src_shape[0], src_dim1=src_shape[1], src_dim2=src_shape[2], src_dim3=src_shape[3],
+        out_dim0=out_shape[0], out_dim1=out_shape[1], out_dim2=out_shape[2], out_dim3=out_shape[3],
+        gather_dim=gather_dim
+    )
+
+    # 验证（PyTorch原生4D gather）
+    ref_out = torch.ops.aten.gather(src, gather_dim, index)
+    torch.testing.assert_close(out, ref_out)
+    print("4D gather结果:\n", out)
+    print("验证通过!\n")
+
+@pytest.mark.parametrize("src_shape, out_shape, gather_dim", [((2, 2, 3, 4, 5), (2, 2, 3, 2, 5), 0)])
+def test_gather_5d(src_shape, out_shape, gather_dim):
+    # 生成测试数据
+    src = torch.arange(src_shape[0]*src_shape[1]*src_shape[2]*src_shape[3]*src_shape[4], device='npu', dtype=torch.float32).reshape(src_shape)
+    index = torch.randint(0, src_shape[gather_dim], out_shape, device='npu', dtype=torch.int64)
+    out = torch.empty(out_shape, device='npu', dtype=torch.float32)
+
+    # 启动5D专用Kernel
+    gather_5d_kernel[(1,)](
+        src, index, out,
+        src_dim0=src_shape[0], src_dim1=src_shape[1], src_dim2=src_shape[2], src_dim3=src_shape[3], src_dim4=src_shape[4],
+        out_dim0=out_shape[0], out_dim1=out_shape[1], out_dim2=out_shape[2], out_dim3=out_shape[3], out_dim4=out_shape[4],
+        gather_dim=gather_dim
+    )
+
+    # 验证（PyTorch原生5D gather）
+    ref_out = torch.ops.aten.gather(src, gather_dim, index)
+    torch.testing.assert_close(out, ref_out)
+    print("5D gather结果:\n", out)
+    print("验证通过!\n")
