+LogicalResult AnnotationOpConverter::matchAndRewrite(
+    AnnotationOp op, OpAdaptor adaptor,
+    ConversionPatternRewriter &rewriter) const {
+  auto loc = op->getLoc();
+  auto names = op.getAttributeNames();
+  assert(names.size() == 1 && "only 1 argument is designed for triton::AnnotationOp");
+  auto annotationOpAttr = op->getAttr(names[0]);
+  assert(op->getNumOperands() == 1 && "Annotation Op should only have one operand");
+  Value opd = op->getOperand(0);
+  auto markOp = rewriter.create<annotation::MarkOp>(loc, opd);
+  markOp->setAttr(names[0], annotationOpAttr);
+  rewriter.replaceOp(op, markOp);
+  return success();
+}
