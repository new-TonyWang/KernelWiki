+def robust_mean(data, method='trimmed', trim_percent=0.2):
+    """
+    计算鲁棒的平均值，减少离群点影响
+    
+    Args:
+        data: 数据列表
+        method: 计算方法 ('trimmed', 'median', 'geometric', 'winsorized')
+        trim_percent: 修剪百分比 (对于trimmed和winsorized方法)
+    
+    Returns:
+        鲁棒的平均值
+    """
+    if not data:
+        return 0
+    
+    data = sorted(data)  # 排序
+    n = len(data)
+    
+    if method == 'median':
+        return statistics.median(data)
+    
+    elif method == 'geometric':
+        # 几何平均数，适合乘法关系的数据
+        if any(x <= 0 for x in data):
+            print("Warning: geometric mean requires positive values, falling back to trimmed mean")
+            method = 'trimmed'
+        else:
+            return statistics.geometric_mean(data)
+    
+    elif method == 'winsorized':
+        # Winsorized mean: 用边界值替换极端值
+        trim_count = int(n * trim_percent / 2)
+        if trim_count > 0:
+            winsorized = data.copy()
+            # 替换最小值
+            for i in range(trim_count):
+                winsorized[i] = data[trim_count]
+            # 替换最大值
+            for i in range(n - trim_count, n):
+                winsorized[i] = data[n - trim_count - 1]
+            return sum(winsorized) / len(winsorized)
+        else:
+            return sum(data) / len(data)
+    
+    else:  # 默认使用trimmed mean
+        # 修剪平均数：去除两端的极端值
+        trim_count = int(n * trim_percent / 2)
+        if trim_count > 0 and n > 2 * trim_count:
+            trimmed_data = data[trim_count:n-trim_count]
+            return sum(trimmed_data) / len(trimmed_data)
+        else:
+            return sum(data) / len(data)
+
