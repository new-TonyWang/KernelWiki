+#!/usr/bin/env python3
+"""
+对比flagtree hint方式和tl.compile_hint方式生成的TTIR是否等价
+"""
+
+import os
+import subprocess
+import shutil
+import difflib
+import glob
+from pathlib import Path
+
+def run_with_dump(script_path, output_file, description):
+    """运行脚本并用重定向保存输出"""
+    print(f"\n=== {description} ===")
+    
+    # 设置环境变量并运行，用重定向保存输出
+    env = os.environ.copy()
+    env['MLIR_ENABLE_DUMP'] = '1'
+    env['TRITON_ALWAYS_COMPILE'] = '1'
+    
+    cmd = f"python3 {script_path} > {output_file} 2>&1"
+    print(f"Running: {cmd}")
+    print(f"Output file: {output_file}")
+    
+    try:
+        result = subprocess.run(cmd, shell=True, env=env, timeout=60)
+        
+        if result.returncode == 0:
+            print("✅ Script executed successfully")
+            
+            # 检查输出文件是否生成
+            if os.path.exists(output_file):
+                file_size = os.path.getsize(output_file)
+                print(f"Generated output file: {output_file} ({file_size} bytes)")
+                return output_file
+            else:
+                print("❌ Output file not generated")
+                return None
+        else:
+            print(f"❌ Script failed with return code {result.returncode}")
+            return None
+            
+    except subprocess.TimeoutExpired:
+        print("❌ Script timed out")
+        return None
+    except Exception as e:
+        print(f"❌ Error running script: {e}")
+        return None
+
+def prepare_files():
+    """准备两个版本的文件"""
+    flagtree_file = "ascend/examples/tutorials/13-matrix-multiplication-optimized-flagtree.py"
+    triton_file = "ascend/examples/tutorials/13-matrix-multiplication-optimized.py"
+    
+    print("✅ Using existing files:")
+    print(f"  Flagtree version: {flagtree_file}")
+    print(f"  Triton-ascend version: {triton_file}")
+    
+    # 验证文件格式
+    with open(flagtree_file, 'r') as f:
+        flagtree_content = f.read()
+    with open(triton_file, 'r') as f:
+        triton_content = f.read()
+    
+    if "# @hint:" in flagtree_content:
+        print("✅ Flagtree file uses comment-style hints")
+    else:
+        print("❌ Flagtree file doesn't have comment-style hints")
+    
+    if "tl.compile_hint" in triton_content:
+        print("✅ Triton-ascend file uses tl.compile_hint calls")
+    else:
+        print("❌ Triton-ascend file doesn't have tl.compile_hint calls")
+    
+    return flagtree_file, triton_file
+
+def compare_output_files(flagtree_output, triton_output):
+    """对比两种方式的输出文件"""
+    print(f"\n=== 输出文件对比 ===")
+    
+    if not flagtree_output or not triton_output:
+        print("❌ 缺少输出文件，无法对比")
+        return False
+    
+    print(f"对比文件:")
+    print(f"  Flagtree: {flagtree_output}")
+    print(f"  Triton-ascend: {triton_output}")
+    
+    # 读取文件内容
+    try:
+        with open(flagtree_output, 'r') as f:
+            flagtree_content = f.readlines()
+        with open(triton_output, 'r') as f:
+            triton_content = f.readlines()
+    except Exception as e:
+        print(f"❌ 读取文件失败: {e}")
+        return False
+    
+    # 过滤掉debug输出和路径信息，只比较核心TTIR
+    def filter_ttir_content(lines):
+        import re
+        ttir_lines = []
+        in_ttir = False
+        for line in lines:
+            if "module {" in line or "tt." in line or "func.func" in line:
+                in_ttir = True
+            if in_ttir and not line.startswith("[DEBUG]") and not line.startswith("[FLAGTREE]"):
+                # 完全移除位置信息，只保留IR操作
+                if line.startswith("#loc") and " = loc(" in line:
+                    # 跳过所有位置定义，这些不影响IR逻辑
+                    continue
+                elif " loc(" in line:
+                    # 移除行内的位置引用，只保留操作本身
+                    line = re.sub(r' loc\([^)]+\)', '', line)
+                ttir_lines.append(line)
+        return ttir_lines
+    
+    flagtree_ttir = filter_ttir_content(flagtree_content)
+    triton_ttir = filter_ttir_content(triton_content)
+    
+    # 生成diff
+    diff = list(difflib.unified_diff(
+        triton_ttir, flagtree_ttir,
+        fromfile="triton-ascend",
+        tofile="flagtree",
+        lineterm=''
+    ))
+    
+    if not diff:
+        print("✅ 两种方式生成的TTIR完全相同！")
+        return True
+    else:
+        print("❌ 两种方式生成的TTIR有差异:")
+        
+        # 只显示前30行差异
+        for i, line in enumerate(diff[:30]):
+            print(line)
+        
+        if len(diff) > 30:
+            print(f"... (还有 {len(diff) - 30} 行差异)")
+        
+        # 保存完整diff到文件
+        diff_file = "ttir_diff.txt"
+        with open(diff_file, 'w') as f:
+            f.writelines(line + '\n' for line in diff)
+        print(f"\n完整diff已保存到: {diff_file}")
+        
+        return False
+
+def main():
+    """主函数"""
+    print("=== Flagtree Hint vs Triton-ascend Compile_hint 对比测试 ===")
+    
+    # 1. 准备两个版本的文件
+    print("\n1. 检查测试文件...")
+    flagtree_file, triton_file = prepare_files()
+    
+    # 2. 运行flagtree版本
+    flagtree_output = "flagtree_output.log"
+    flagtree_result = run_with_dump(flagtree_file, flagtree_output, 
+                                   "运行Flagtree注释版本")
+    
+    # 3. 运行triton-ascend版本
+    triton_output = "triton_output.log"
+    triton_result = run_with_dump(triton_file, triton_output, 
+                                 "运行Triton-ascend版本")
+    
+    # 4. 对比输出文件中的TTIR
+    is_equivalent = compare_output_files(flagtree_result, triton_result)
+    
+    # 5. 总结
+    print(f"\n=== 测试结果 ===")
+    if is_equivalent:
+        print("✅ 两种hint方式生成的TTIR完全等价！")
+        print("✅ Flagtree注释方式实现正确！")
+    else:
+        print("❌ 两种hint方式生成的TTIR有差异")
+        print("❌ 需要检查实现是否正确")
+    
+    print(f"\n输出文件位置:")
+    print(f"  Flagtree: {flagtree_output}")
+    print(f"  Triton-ascend: {triton_output}")
+
+if __name__ == "__main__":
+    main()

