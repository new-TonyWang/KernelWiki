+        # 查找输出目录
+        output_match = re.search(r'OPPROF_\d+_[A-Z]+', result.stdout)
+        if not output_match:
+            print(f"No output directory found in stdout: {result.stdout}")
+            return None, None
+        
+        output_dir = output_match.group()
+        csv_file = f"/workspace/triton-ascend/ascend/examples/pytest_ut/{output_dir}/OpBasicInfo.csv"
