diff --git a/triton_patch/python/triton_patch/language/semantic.py b/triton_patch/python/triton_patch/language/semantic.py
@@ -841,3 +841,100 @@ def make_tensor_descriptor(
     handle = builder.create_make_tensor_descriptor(base_handle, [s.handle for s in shape],
                                                     [s.handle for s in strides], block_shape, is_signed_int)
     return tensor_descriptor(handle, shape, strides, desc_block_type)
+
+
+def gather_load(
+    src: tl.tensor,
+    gather_dim: int,
+    gather_indices: tl.tensor,
+    src_shape: List[int],
+    src_offset: List[int],
+    read_shape: List[int],
+    builder: ir.builder
+) -> tl.tensor:
+    """
+    Gather load operation that loads data from multiple indices along a dimension.
+    
+    Args:
+        src: Source tensor pointer (in GM)
+        gather_dim: Dimension along which to gather
+        gather_indices: 1D tensor of indices to gather (in UB)
+        src_shape: Complete shape of source tensor
+        src_offset: Starting offset for reading
+        read_shape: Size to read (tile shape)
+        builder: IR builder
+        
+    Returns:
+        Result tensor in UB
+        
+    Constraints:
+        - read_shape[gather_dim] must be -1
+        - src_offset[gather_dim] can be -1 (ignored)
+    """
+    # Validate inputs
+    if not isinstance(gather_dim, int):
+        raise ValueError(f"gather_dim must be an integer, got {type(gather_dim)}")
+    
+    if not isinstance(src_shape, (list, tuple)):
+        raise ValueError(f"src_shape must be a list or tuple, got {type(src_shape)}")
+    
+    if not isinstance(src_offset, (list, tuple)):
+        raise ValueError(f"src_offset must be a list or tuple, got {type(src_offset)}")
+    
+    if not isinstance(read_shape, (list, tuple)):
+        raise ValueError(f"read_shape must be a list or tuple, got {type(read_shape)}")
+    
+    ndim = len(src_shape)
+    if len(src_offset) != ndim or len(read_shape) != ndim:
+        raise ValueError(f"src_shape, src_offset, and read_shape must have same length. "
+                        f"Got {ndim}, {len(src_offset)}, {len(read_shape)}")
+    
+    if not (0 <= gather_dim < ndim):
+        raise ValueError(f"gather_dim {gather_dim} out of range for {ndim}D tensor")
+    
+    if read_shape[gather_dim] != -1:
+        raise ValueError(f"read_shape[gather_dim={gather_dim}] must be -1, got {read_shape[gather_dim]}")
+    
+    # Validate gather_indices is 1D
+    if not gather_indices.type.is_block():
+        raise ValueError("gather_indices must be a tensor")
+    
+    indices_shape = gather_indices.type.get_block_shapes()
+    if len(indices_shape) != 1:
+        raise ValueError(f"gather_indices must be 1D, got shape {indices_shape}")
+    
+    num_indices = indices_shape[0]
+    
+    # Build output shape: replace gather_dim with num_indices
+    output_shape = []
+    for i, size in enumerate(read_shape):
+        if i == gather_dim:
+            output_shape.append(num_indices)
+        else:
+            if size <= 0:
+                raise ValueError(f"read_shape[{i}] must be positive, got {size}")
+            output_shape.append(size)
+    
+    # Determine output element type from src
+    if hasattr(src.type, 'element_ty'):
+        element_ty = src.type.element_ty
+    elif hasattr(src.type, 'scalar'):
+        element_ty = src.type.scalar
+    else:
+        raise ValueError(f"Cannot determine element type from src type: {src.type}")
+    
+    # Create output type
+    output_ty = tl.block_type(element_ty, output_shape)
+    
+    # Create the gather_load op
+    # The builder will create the operation and return the result handle
+    handle = builder.create_gather_load(
+        src.handle,
+        gather_indices.handle,
+        gather_dim,
+        src_shape,
+        src_offset,
+        read_shape
+    )
+    
+    return tl.tensor(handle, output_ty)
