@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""
+Simplest MLIR generator - NO CANN/NPU required!
+
+Usage after installing triton-ascend:
+    python generate_mlir_frontend_only.py
+"""
+import os
+os.environ['TORCH_DEVICE_BACKEND_AUTOLOAD'] = '0'
+
+import triton
+import triton.language as tl
+import triton.language.extra.ascend as al
+from triton.compiler.compiler import ASTSource
+from triton.compiler.code_generator import ast_to_ttir
+
+try:
+    from triton._C.libtriton import ir  # type: ignore  # C extension - built during install
+except ImportError as e:
+    print("❌ Error: triton._C.libtriton not found")
+    print("   Run: pip install -e /home/hocky/triton-ascend")
+    print(f"   Details: {e}")
+    exit(1)
+
+
+class Options:
+    num_warps = 4
+    num_stages = 3
+    num_ctas = 1
+    cluster_dims = (1, 1, 1)
+    enable_fp_fusion = True
+    debug = False
+
+
+def generate_mlir(kernel, signature, constexprs, output=None):
+    """Generate MLIR from Triton kernel - returns MLIR string"""
+    src = ASTSource(kernel, signature, constexprs)
+    context = ir.context()
+    ir.load_dialects(context)
+    module = ast_to_ttir(kernel, src, context, Options(), {}, {})
+    mlir = str(module)
+    if output:
+        open(output, 'w').write(mlir)
+    return mlir
+
+
+if __name__ == "__main__":
+    # Example: Simple addition kernel with Ascend scope
+    @triton.jit
+    def add(x_ptr, y_ptr, out_ptr, n, BLOCK: tl.constexpr):
+        i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+        
+        with al.Scope(core_mode="vector"):
+            with al.Scope(core_mode="vector"):
+                with al.Scope(core_mode="vector"):
+                    with al.Scope(core_mode="vector"):
+                        x = tl.load(x_ptr + i, mask=i < n)
+                        y = tl.load(y_ptr + i, mask=i < n)
+                        result = x + y
+                        tl.store(out_ptr + i, result, mask=i < n)
+    
+    mlir = generate_mlir(
+        kernel=add,
+        signature={"x_ptr": "*fp32", "y_ptr": "*fp32", "out_ptr": "*fp32", "n": "i32"},
+        constexprs={"BLOCK": 256},
+        output="/tmp/add.ttir"
+    )
+    
+    print(f"✅ {len(mlir)} chars → /tmp/add.ttir")
+    print("\n" + "="*80)
+    print("Generated MLIR (add.ttir):")
+    print("="*80)
+    
+    # Read and print the generated TTIR file
+    with open("/tmp/add.ttir", "r") as f:
+        ttir_content = f.read()
+        print(ttir_content)
+    
+    print("="*80)

