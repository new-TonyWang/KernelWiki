+
+import torch
+
+import triton
+import triton.language as tl
+from triton.compiler import ASTSource
+import triton.extension.buffer.language as bl
+
+target = triton.runtime.driver.active.get_current_target()
+
+
+@triton.jit
+def test_subview_kernel1(XBLOCK: tl.constexpr):
+    # 1. Allocate a local buffer
+    src_buffer = bl.allocate_local_buffer(tl.float32, [XBLOCK, XBLOCK])
+    
+    result_buffer = bl.subview(
+        src_buffer,
+        offsets=[1, 1],
+        sizes=[XBLOCK-2, XBLOCK-2],
+        strides=[1, 1]
+    )
+
+@triton.jit
+def test_subview_kernel2(XBLOCK: tl.constexpr, offsets: tl.constexpr, sizes: tl.constexpr, strides: tl.constexpr):
+    # this statement has no effect, just to test the builder
+    bl.allocate_local_buffer(tl.float32, [XBLOCK]).subview([offsets], [sizes], [strides])
+
+def test_subview_function():
+    src = ASTSource(
+        fn=test_subview_kernel1,
+        constants={'XBLOCK': 8},
+        signature={},
+    )
+
+    triton.compile(src=src, target=target)
+    
+def test_subview_constructor():
+    src = ASTSource(
+        fn=test_subview_kernel2,
+        constants={'XBLOCK': 32, 'offsets': 1, 'sizes': 30, 'strides': 1},
+        signature={},
+    )
+    triton.compile(src=src, target=target)
