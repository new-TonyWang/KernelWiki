+def gather_load(
+    src: tl.tensor,
+    gather_dim: int,
+    gather_indices: tl.tensor,
+    src_shape: List,  # Can be int or tl.tensor
+    src_offset: List,  # Can be int or tl.tensor
+    read_shape: List,  # Can be int or tl.tensor
+    builder: ir.builder
+) -> tl.tensor:
+    """
+    Gather load operation that loads data from multiple indices along a dimension.
+
+    Args:
+        src: Source tensor pointer (in GM)
+        gather_dim: Dimension along which to gather
+        gather_indices: 1D tensor of indices to gather (in UB)
+        src_shape: Complete shape of source tensor (can be int or tensor)
+        src_offset: Starting offset for reading (can be int or tensor)
+        read_shape: Size to read (tile shape, can be int or tensor)
+        builder: IR builder
+
+    Returns:
+        Result tensor in UB
+
+    Constraints:
+        - read_shape[gather_dim] must be -1
+        - src_offset[gather_dim] can be -1 (ignored)
+    """
+    # Validate inputs
+    if not isinstance(gather_dim, int):
+        raise ValueError(f"gather_dim must be an integer, got {type(gather_dim)}")
+
+    if not isinstance(src_shape, (list, tuple)):
+        raise ValueError(f"src_shape must be a list or tuple, got {type(src_shape)}")
+
+    if not isinstance(src_offset, (list, tuple)):
+        raise ValueError(f"src_offset must be a list or tuple, got {type(src_offset)}")
+
+    if not isinstance(read_shape, (list, tuple)):
+        raise ValueError(f"read_shape must be a list or tuple, got {type(read_shape)}")
+
+    ndim = len(src_shape)
+    if len(src_offset) != ndim or len(read_shape) != ndim:
+        raise ValueError(f"src_shape, src_offset, and read_shape must have same length. "
+                        f"Got {ndim}, {len(src_offset)}, {len(read_shape)}")
+
+    if not (0 <= gather_dim < ndim):
+        raise ValueError(f"gather_dim {gather_dim} out of range for {ndim}D tensor")
+
+    # Validate gather_indices is 1D
+    if not gather_indices.type.is_block():
+        raise ValueError("gather_indices must be a tensor")
+
+    indices_shape = gather_indices.type.get_block_shapes()
+    if len(indices_shape) != 1:
+        raise ValueError(f"gather_indices must be 1D, got shape {indices_shape}")
+
+    num_indices = indices_shape[0]
+
+    # Convert parameters to Value handles
+    # For src_shape, src_offset, read_shape: convert int to tensor
+    def to_value_handle(val):
+        if isinstance(val, tl.tensor):
+            return val.handle
+        elif isinstance(val, int):
+            # Convert int constant to i64 constant
+            return builder.get_int64(val)
+        else:
+            raise ValueError(f"Expected int or tensor, got {type(val)}")
+
+    src_shape_handles = [to_value_handle(v) for v in src_shape]
+    src_offset_handles = [to_value_handle(v) for v in src_offset]
+    read_shape_handles = [to_value_handle(v) for v in read_shape]
+
+    # For static validation, extract constant values where possible
+    def get_const_value(val):
+        """Try to get constant value, return None if dynamic"""
+        if isinstance(val, int):
+            return val
+        # For tensor, we can't extract compile-time constant
+        return None
+
+    # Validate read_shape[gather_dim] is -1 if it's a constant
+    read_shape_gather_val = get_const_value(read_shape[gather_dim])
+    if read_shape_gather_val is not None and read_shape_gather_val != -1:
+        raise ValueError(f"read_shape[gather_dim={gather_dim}] must be -1, got {read_shape_gather_val}")
+
+    # Build output shape: replace gather_dim with num_indices
+    # For dynamic shapes, we can only compute output shape for known dimensions
+    output_shape = []
+    for i in range(ndim):
+        if i == gather_dim:
+            output_shape.append(num_indices)
+        else:
+            size = get_const_value(read_shape[i])
+            if size is not None:
+                if size <= 0 and size != -1:
+                    raise ValueError(f"read_shape[{i}] must be positive or -1, got {size}")
+                output_shape.append(size if size > 0 else 1)  # Use 1 as placeholder for dynamic
+            else:
+                # Dynamic size, use placeholder (will be determined at runtime)
+                output_shape.append(1)
+
+    # Determine output element type from src
+    if hasattr(src.type, 'element_ty'):
+        element_ty = src.type.element_ty
+    elif hasattr(src.type, 'scalar'):
+        element_ty = src.type.scalar
+    else:
+        raise ValueError(f"Cannot determine element type from src type: {src.type}")
+
+    # Create output type
+    output_ty = tl.block_type(element_ty, output_shape)
+
+    # Create the gather_load op with Value handles
+    handle = builder.create_gather_load(
+        src.handle,
+        gather_indices.handle,
+        gather_dim,
+        src_shape_handles,
+        src_offset_handles,
+        read_shape_handles
+    )
+
+    return tl.tensor(handle, output_ty)
